{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "services": {
    "storefront": {
      "root": ".",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "medusa": {
      "root": "backend/",
      "runtime": "container",
      "entrypoint": "apps/backend/Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/app/(.*)",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/auth",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/store",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/store/(.*)",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/files",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/files/(.*)",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/hooks",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/hooks/(.*)",
      "destination": {
        "service": "medusa"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "storefront"
      }
    }
  ],
  "headers": [
    {
      "source": "/(app|admin|auth|store|files|health|hooks)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}