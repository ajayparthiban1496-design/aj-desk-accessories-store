# Copy to .env for local development (never commit .env).
# In production set these in Vercel -> Project -> Settings -> Environment Variables.

# Database: Neon (via Vercel Storage) sets DATABASE_URL and DATABASE_URL_UNPOOLED.
# Medusa uses the unpooled one when present. Pull them locally with:
#   npx vercel env pull --environment development
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Redis (Upstash via Vercel sets KV_URL / REDIS_URL). Optional locally.
REDIS_URL=

# Two different long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=

# Allowed origins, comma separated. Production: the live domain.
STORE_CORS=http://localhost:5173,http://localhost:4173
ADMIN_CORS=http://localhost:5174,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:4173,http://localhost:5174,http://localhost:9000

MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Storefront address, used in emails (password reset link, order link).
STOREFRONT_URL=http://localhost:5173

# Email (optional until connected): Resend API key and a verified sender.
RESEND_API_KEY=
STORE_EMAIL_FROM="Aj Desk <orders@yourdomain.com>"

# Files: by default kept in Postgres and served from /files/<key>.
# FILE_BASE_URL prefixes those URLs (empty in production, http://localhost:9000 locally).
FILE_BASE_URL=
# Optional S3-compatible storage instead (AWS S3, Cloudflare R2, ...)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FILE_URL=

# Stock given by the seed to inventory items it has no catalogue figure for
DEFAULT_STOCK_QUANTITY=10
