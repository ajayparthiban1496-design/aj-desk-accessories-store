# ── Frontend (exposed to the browser — public values only) ─────────────
# Leave both empty to run in DEMO MODE (local seed data + localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public site URL used for canonical/OG tags
VITE_SITE_URL=http://localhost:5173
# Optional analytics: set to your domain to enable Plausible
VITE_PLAUSIBLE_DOMAIN=

# ── Supabase Edge Function secrets (NEVER put these in VITE_ vars) ────
# Set with: supabase secrets set KEY=value
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
# STORE_EMAIL_FROM="Aj Desk <orders@yourdomain.com>"
# SITE_URL=https://your-deployed-site.com
