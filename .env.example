# ── Storefront (Vite). VITE_* values are bundled into the browser: public only. ──
# Leave empty in production: Medusa is served from the same domain (see vercel.json).
# Locally: http://localhost:9000
VITE_MEDUSA_BACKEND_URL=
# Publishable key of the "Aj Desk Web Key" (Medusa Admin -> Settings -> Publishable API Keys,
# or: cd backend/apps/backend && npx medusa exec ./src/scripts/publishable-key.ts).
# Without it the site shows the bundled catalogue and ordering is paused.
VITE_MEDUSA_PUBLISHABLE_KEY=
VITE_SITE_URL=https://aj-desk-accessories-store.vercel.app
# Optional analytics: your domain to enable Plausible
VITE_PLAUSIBLE_DOMAIN=

# Backend secrets live in backend/apps/backend/.env (see its .env.template)
# and in Vercel -> Settings -> Environment Variables. Never prefix them with VITE_.
